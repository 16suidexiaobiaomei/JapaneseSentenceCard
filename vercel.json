{
  "cleanUrls": true,
  "functions": {
    "api/romaji.js": {
      "maxDuration": 30,
      "includeFiles": "node_modules/kuromoji/dict/**"
    }
  },
  "crons": [
    { "path": "/api/reconcile-premium", "schedule": "0 3 * * *" }
  ],
  "rewrites": [
    { "source": "/tag/:id", "destination": "/tag-fallback" }
  ],
  "headers": [
    {
      "source": "/.well-known/apple-app-site-association",
      "headers": [{ "key": "Content-Type", "value": "application/json" }]
    }
  ]
}
